APP_NAME=Interview IQ
APP_ENV=development
APP_DEBUG=true

API_V1_PREFIX=/api

SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=mysql+pymysql://root:password@localhost:3306/interview_iq
DATABASE_NAME_OVERRIDE=
TEST_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/interview_iq_test

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads
MAX_RESUME_SIZE_MB=10
MAX_AUDIO_SIZE_MB=50
MAX_VIDEO_SIZE_MB=250

AI_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# Optional — only used if Ollama is unreachable and one of these is set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

WHISPER_MODEL=base
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

FFMPEG_PATH=ffmpeg

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@interviewiq.local

PAYMENT_MODE=payhere
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/app/checkout?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/app/checkout?payment=cancelled
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Required to cancel recurring subscriptions from the app.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_CURRENCY=LKR
PAYHERE_RETURN_URL=http://localhost:8000/api/subscriptions/payhere/return?order_id={ORDER_ID}
PAYHERE_CANCEL_URL=http://localhost:8000/api/subscriptions/payhere/cancel?order_id={ORDER_ID}
# Must be a public HTTPS URL; PayHere cannot notify localhost.
PAYHERE_NOTIFY_URL=https://your-domain.example/api/subscriptions/payhere/notify
PAYHERE_COUNTRY=Sri Lanka

RATE_LIMIT_ENABLED=false
LOG_LEVEL=INFO

ADMIN_SEED_EMAIL=admin@interviewiq.com
ADMIN_SEED_PASSWORD=ChangeMe123!
